# App
APP_NAME="CRM для менеджеров"
APP_PORT=3000
APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
HOSTNAME=0.0.0.0
PORT=3000

# Auth
AUTH_SECRET=change_me_long_random_string
CRON_SECRET=change_me_cron_secret

# Crypto
EMAIL_ENCRYPTION_KEY=change_me_base64_32_bytes_key_change_me

# Postgres for docker compose
POSTGRES_USER=crm
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=crm

# Database URL for local non-docker development
DATABASE_URL=postgresql://crm:change_me_db_password@localhost:5432/crm

# Seed
SEED_ON_BOOT=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

SEED_DEMO_MANAGER=true
DEMO_MANAGER_EMAIL=manager@example.com
DEMO_MANAGER_PASSWORD=Manager123!

# Cron
CRON_INTERVAL_SECONDS=300
CRON_TARGET_URL=http://app:3000/api/cron/run